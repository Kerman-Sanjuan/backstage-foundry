# Copy to .env and fill in. Never commit .env.
#
# The endpoint of your Foundry project (or the APIM GenAI gateway in front of it).
# Use the gateway, not the project, if you are demonstrating attribution:
# the gateway is what knows who the caller is.
FOUNDRY_ENDPOINT=https://<your-apim-or-foundry>.example.com

# Deployment name, not model name. This is the field the platform team controls.
FOUNDRY_DEPLOYMENT=gpt-4o-mini

# Only needed for local runs without OIDC. In CI, use federated credentials.
FOUNDRY_API_KEY=

# Used by the cost report: price per 1M tokens of the deployment above.
COST_INPUT_PER_1M=0.15
COST_OUTPUT_PER_1M=0.60
